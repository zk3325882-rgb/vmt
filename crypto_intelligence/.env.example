# ---- Database ----
# PostgreSQL (recommended for production use):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crypto_intel
# SQLite fallback (used automatically if DATABASE_URL is empty):
DATABASE_URL=

# ---- RPC endpoints (comma separated list = failover order) ----
ETH_RPC_URL=https://eth.llamarpc.com,https://ethereum-rpc.publicnode.com,https://rpc.ankr.com/eth
BSC_RPC_URL=https://bsc-rainbloc.io,https://bsc-dataseed.binance.org,https://bsc-rpc.publicnode.com

# ---- Optional market data ----
PRICE_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ---- Scanner behaviour ----
MOCK_MODE=false            # true = offline synthetic chain data (dev only)
START_BLOCK_LOOKBACK=30    # how many blocks back to start on very first run
SCAN_INTERVAL_SECONDS=3
DB_BATCH_SIZE=200
POLL_LOG_CHUNK=2000        # max block range per eth_getLogs call

# ---- Thresholds for large-transaction detection ----
MIN_USD_ALERT=10000        # minimum USD value to be considered "large"
MIN_ANOMALY_SCORE=40       # minimum score stored in large_transactions

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=8000
